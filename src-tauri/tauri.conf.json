{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hurricaneTerm",
  "version": "0.3.0",
  "identifier": "io.github.edwardlewis35.hurricaneterm",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "hurricaneTerm",
        "width": 1000,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils"
      }
    }
  }
}
